# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173

# MongoDB Database Connection
# Replace with your MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/auctionDB
LOCAL_MONGO_URI=mongodb://127.0.0.1:27017/auctionDB

# Authentication & Session Secrets
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_key_here

# Microservices URLs
ML_SERVICE_URL=http://127.0.0.1:5001
DAMAGE_SERVICE_URL=http://127.0.0.1:5002

# Cloudinary Storage (for vehicle image uploads)
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Groq LLM RAG AI Assistant Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_PROVIDER=local
